        "df_etl = (\n",
        "    df_bruto\n",
        "    .dropDuplicates([\"veiculo_id\", \"timestamp\"])\n",
        "    .dropna(subset=[\n",
        "        \"veiculo_id\", \"latitude\", \"longitude\",\n",
