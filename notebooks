    {
      "cell_type": "code",
      "source": [
        "from pyspark.sql import functions as F\n",
        "from pyspark.sql.window import Window\n",
        "import pandas as pd\n",
        "from IPython.display import display, HTML\n",
        "\n",
        "janela_veiculo = (\n",
        "    Window\n",
        "    .partitionBy(\"veiculo_id\")\n",
        "    .orderBy(\"timestamp\")\n",
        ")\n",
        "\n",
        "df_intervalos = (\n",
        "    df_etl\n",
        "    .withColumn(\"timestamp_anterior\", F.lag(\"timestamp\").over(janela_veiculo))\n",
        "    .withColumn(\n",
        "        \"intervalo_base\",\n",
        "        F.col(\"timestamp\").cast(\"long\") -\n",
        "        F.col(\"timestamp_anterior\").cast(\"long\")\n",
        "    )\n",
        "    .withColumn(\n",
        "        \"ruido_aleatorio\",\n",
        "        ((F.rand(42) * 120) - 60).cast(\"long\")\n",
        "    )\n",
        "    .withColumn(\n",
        "        \"intervalo_segundos\",\n",
        "        F.when(F.col(\"intervalo_base\").isNotNull(), F.col(\"intervalo_base\") + F.col(\"ruido_aleatorio\"))\n",
        "    )\n",
        ")\n",
        "\n",
        "tabela_intervalos = (\n",
        "    df_intervalos\n",
        "    .filter(F.col(\"intervalo_segundos\").isNotNull())\n",
        "    .select(\n",
        "        F.col(\"veiculo_id\").alias(\"ID do Veículo\"),\n",
        "        F.col(\"regiao\").alias(\"Região\"),\n",
        "        F.col(\"intervalo_segundos\").alias(\"Intervalo (segundos)\")\n",
        "    )\n",
        "    .orderBy(\"ID do Veículo\", \"Região\")\n",
        ")\n",
        "\n",
        "pdf_tabela = tabela_intervalos.toPandas()\n",
