      "source": [
        "analise_regional = (\n",
        "    df_etl\n",
        "    .groupBy(\"regiao\")\n",
        "    .agg(\n",
        "        F.round(F.avg(\"velocidade_kmh\"), 2).alias(\"velocidade_media_kmh\"),\n",
        "        F.count(\"*\").alias(\"quantidade_registros\"),\n",
        "        F.round(F.avg(\"latitude\"), 5).alias(\"latitude_media\"),\n",
        "        F.round(F.avg(\"longitude\"), 5).alias(\"longitude_media\")\n",
        "    )\n",
        "    .orderBy(\"velocidade_media_kmh\")\n",
        ")\n",
        "\n",
        "limite_velocidade = 20.0\n",
        "\n",
        "gargalos = (\n",
        "    analise_regional\n",
        "    .withColumn(\n",
        "        \"classificacao\",\n",
        "        F.when(\n",
        "            F.col(\"velocidade_media_kmh\") < limite_velocidade,\n",
        "            \"Possível gargalo\"\n",
        "        ).otherwise(\"Fluxo menos lento\")\n",
        "    )\n",
        ")\n",
        "\n",
        "gargalos.show(truncate=False)"
