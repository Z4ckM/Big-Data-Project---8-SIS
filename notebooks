    {
      "cell_type": "code",
      "source": [
        "regioes = {\n",
        "    \"Centro\": (-15.7801, -47.9292, 18),\n",
        "    \"Setor Norte\": (-15.7550, -47.9100, 32),\n",
        "    \"Setor Sul\": (-15.8200, -47.9300, 28),\n",
        "    \"Terminal\": (-15.7900, -47.9500, 15)\n",
        "}\n",
        "\n",
        "linhas = [\"110\", \"120\", \"130\"]\n",
        "veiculos = [f\"BUS{i:03d}\" for i in range(1, 13)]\n",
        "\n",
        "inicio = datetime(2026, 10, 10, 6, 0, 0)\n",
        "registros = []\n",
        "\n",
        "for veiculo_idx, veiculo in enumerate(veiculos):\n",
        "    linha = linhas[veiculo_idx % len(linhas)]\n",
        "\n",
        "    for passo in range(144):  # 12 horas, com uma observação a cada 5 minutos\n",
        "        instante = inicio + timedelta(minutes=5 * passo)\n",
        "        hora = instante.hour\n",
        "\n",
        "        # Cada veículo percorre as quatro regiões em sequência.\n",
        "        nomes_regioes = list(regioes.keys())\n",
        "        regiao = nomes_regioes[(passo + veiculo_idx) % len(nomes_regioes)]\n",
        "        lat_base, lon_base, velocidade_base = regioes[regiao]\n",
        "\n",
        "        # Simulação de lentidão nos períodos de pico.\n",
        "        horario_pico = (7 <= hora < 9) or (16 <= hora < 18)\n",
        "        fator_pico = 0.45 if horario_pico else 1.0\n",
        "        velocidade = max(\n",
        "            3.0,\n",
        "            random.gauss(velocidade_base * fator_pico, 3.0)\n",
        "        )\n",
        "\n",
        "        latitude = lat_base + random.uniform(-0.002, 0.002)\n",
        "        longitude = lon_base + random.uniform(-0.002, 0.002)\n",
        "\n",
        "        registros.append((\n",
        "            veiculo,\n",
        "            linha,\n",
        "            f\"PARADA_{(passo % 12) + 1:02d}\",\n",
        "            latitude,\n",
        "            longitude,\n",
        "            round(velocidade, 2),\n",
        "            instante,\n",
        "            regiao\n",
        "        ))\n",
        "\n",
        "schema = StructType([\n",
        "    StructField(\"veiculo_id\", StringType(), False),\n",
        "    StructField(\"linha\", StringType(), False),\n",
        "    StructField(\"parada_id\", StringType(), False),\n",
        "    StructField(\"latitude\", DoubleType(), False),\n",
        "    StructField(\"longitude\", DoubleType(), False),\n",
        "    StructField(\"velocidade_kmh\", DoubleType(), False),\n",
        "    StructField(\"timestamp\", TimestampType(), False),\n",
        "    StructField(\"regiao\", StringType(), False)\n",
        "])\n",
        "\n",
        "df_bruto = spark.createDataFrame(registros, schema=schema)\n",
        "\n",
        "print(f\"Total de registros simulados: {df_bruto.count()}\")\n",
        "df_bruto.show(10, truncate=False)\n",
        "df_bruto.printSchema()"
      ],
